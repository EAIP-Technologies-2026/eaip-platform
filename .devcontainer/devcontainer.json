{
  "name": "EAIP — Enterprise Autonomous Intelligence Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/eaip-platform",
  "containerEnv": {
    "EAIP_CORE__ENVIRONMENT": "development",
    "EAIP_LOGGING__LEVEL": "DEBUG",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "postStartCommand": "echo '✓ EAIP devcontainer ready. Run: make help'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint",
        "EditorConfig.EditorConfig",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "streetsidesoftware.code-spell-checker",
        "Gruntfuggly.todo-tree",
        "vivaxy.vscode-conventional-commits",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/eaip-platform/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "forwardPorts": [],
  "portsAttributes": {},
  "mounts": [
    "source=eaip-bashhistory,target=/commandhistory,type=volume"
  ]
}
