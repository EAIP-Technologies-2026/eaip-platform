# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file.
root = true

# Defaults for every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Python
[*.py]
indent_size = 4

# Stubs
[*.pyi]
indent_size = 4

# JavaScript / TypeScript / JSON / YAML / TOML / Markdown frontends use 2 spaces
[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,toml,html,css,scss}]
indent_size = 2

# Markdown — preserve trailing spaces (used for hard line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Makefiles require tabs
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

# Go (in case we add helpers later)
[*.go]
indent_style = tab

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 2

# Dockerfile
[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2

# Git config files
[.git*]
indent_size = 2
