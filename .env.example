# =========================================
# EAIP Runtime Configuration — example
# =========================================
# Copy this file to `.env` and adjust for your local environment.
#   cp .env.example .env
#
# NEVER commit the real `.env` or `.env.local` files (they are git-ignored).
# Never put production secrets in this file — use real values only in `.env`.

# --- Environment ------------------------------------------------------------
# Valid values: development | production | test | local
EAIP_ENVIRONMENT=development
EAIP_VERSION=latest
EAIP_LOG_LEVEL=INFO

# --- Authentication ---------------------------------------------------------
# REQUIRED — the backend refuses to start without this.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
EAIP_AUTH_SECRET=change-this-to-a-long-random-secret-for-development

# --- Database (Docker PostgreSQL) -------------------------------------------
# Used when EAIP_DB_PROVIDER=local (the default).
EAIP_DB_NAME=eaip
EAIP_DB_USER=eaip
EAIP_DB_PASSWORD=eaip_dev_password

# --- Database Provider ------------------------------------------------------
# Valid values: local | neon
#   local -> Docker PostgreSQL (docker-compose.yml)
#   neon  -> Neon serverless Postgres (requires EAIP_NEON_* below)
EAIP_DB_PROVIDER=local

# --- Neon Database (only when EAIP_DB_PROVIDER=neon) -------------------------
EAIP_NEON_HOST=ep-example-abc.us-east-2.aws.neon.tech
EAIP_NEON_PORT=5432
EAIP_NEON_NAME=eaip
EAIP_NEON_USER=eaip
EAIP_NEON_PASSWORD=
EAIP_NEON_PROJECT_ID=
EAIP_NEON_BRANCH=

# --- HTTP / Ports ------------------------------------------------------------
# Backend listens on this port (default 8080).
EAIP_HTTP_PORT=8080
# Host-side ports for the Docker infra services.
EAIP_DB_EXPOSE_PORT=5432
EAIP_REDIS_EXPOSE_PORT=6379
EAIP_QDRANT_EXPOSE_PORT=6333

# --- CORS (optional) ---------------------------------------------------------
# Comma-separated list of allowed origins. If unset, defaults are used.
#EAIP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Sentry (optional) -------------------------------------------------------
# Leave DSN empty to disable Sentry.
EAIP_SENTRY_DSN=
EAIP_SENTRY_ENVIRONMENT=
EAIP_SENTRY_RELEASE=
EAIP_SENTRY_TRACES_SAMPLE_RATE=0

# --- Telemetry / OpenTelemetry (optional) ------------------------------------
#EAIP_TELEMETRY_SERVICE_NAME=eaip
#EAIP_TELEMETRY_OTLP_ENDPOINT=http://localhost:4318
#EAIP_TELEMETRY_TRACING_ENABLED=true
#EAIP_TELEMETRY_METRICS_ENABLED=true

# --- Better Stack (optional) -------------------------------------------------
#EAIP_BESTACK_API_KEY=
#EAIP_BESTACK_ORGANIZATION=
#EAIP_BESTACK_PROJECT=
#EAIP_BESTACK_ENABLED=false

# --- Release metadata (optional) ---------------------------------------------
#EAIP_RELEASE_VERSION=
#EAIP_RELEASE_ENVIRONMENT=
#EAIP_RELEASE_COMMIT=
#EAIP_RELEASE_BRANCH=

# --- LLM provider keys (optional, loaded from .env.local) --------------------
# These are consumed by provider adapters when configured. Leave empty if unused.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_MODELS_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
